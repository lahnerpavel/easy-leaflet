{
    "name": "forup/easy-leaflet",
    "description": "Simple, universal PHP library for rendering Leaflet.js maps (PHP 5.6+)",
    "type": "library",
    "license": "MIT",
    "keywords": ["leaflet", "map", "gis", "openstreetmap"],
    "homepage": "https://github.com/lahnerpavel/easy-leaflet",
    "require": {
        "php": ">=5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Forup\\EasyLeaflet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Forup\\EasyLeaflet\\Tests\\": "tests/"
        }
    }
}
